# GEOINT Buddy 环境配置示例；复制为 .env 后填入自己的密钥，禁止提交真实密钥。
# 网络状态：ONLINE / DEGRADED / OFFLINE
NETWORK_STATE=ONLINE

# 区域配置：相对 backend/ 目录；切换区域无需修改 Agent 代码。
REGION_PROFILE=regions/baige.json

# 云端 OpenAI 兼容接口（可选）；OFFLINE 模式无需配置。
# 板端无外网时经上行代理访问：HTTPS_PROXY/NO_PROXY 见启动命令。
CLOUD_BASE_URL=https://api.anyint.ai/openai/v1
CLOUD_API_KEY=replace-with-your-own-key
CLOUD_MODEL=claude-sonnet-5
CLOUD_VLM_MODEL=claude-sonnet-5

# 端侧 llama.cpp（板端 llama-server）
EDGE_BASE_URL=http://127.0.0.1:8081/v1
EDGE_MODEL=qwen3vl-4b-local
